# Copiar a .env.local y completar con valores reales del entorno.
#
# DATABASE_URL debe apuntar al rol de aplicación (crd_app), nunca al
# propietario del esquema (crd_owner).
DATABASE_URL=postgresql://crd_app:CAMBIAR@localhost:5432/crd_rbac_poc

# Secreto para firmar la cookie de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIAR
